# Copy to `.env` for local development.

# Postgres connection string.
# Local: matches docker-compose.yml. Production: the Neon *pooled* connection string.
# 127.0.0.1 rather than localhost: Node may resolve localhost to IPv6 (::1), which some
# Docker Desktop setups don't forward.
DATABASE_URL=postgres://survey:survey@127.0.0.1:5434/survey

# Secret that signs admin session tokens (JWT). At least 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
